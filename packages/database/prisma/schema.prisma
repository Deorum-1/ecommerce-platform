generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Tenant {
  id                  String         @id @default(cuid())
  name                String
  slug                String         @unique
  clerkOrganizationId String?        @unique
  logoUrl             String?
  currency            String         @default("NGN")
  description         String?
  contactEmail        String?
  website             String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  members             TenantMember[]
  categories          Category[]
  products            Product[]
  customers           Customer[]
  orders              Order[]
  discounts           Discount[]
}

model Discount {
  id              String       @id @default(cuid())
  tenantId        String
  code            String
  type            DiscountType
  value           Decimal      @db.Decimal(12, 2)
  active          Boolean      @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  usageLimit      Int?
  usageCount      Int          @default(0)
  minimumSubtotal Decimal?     @db.Decimal(12, 2)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model TenantMember {
  id          String   @id @default(cuid())
  tenantId    String
  clerkUserId String
  role        String   @default("OWNER")
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clerkUserId])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Category {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id          String        @id @default(cuid())
  tenantId    String
  categoryId  String?
  name        String
  slug        String
  description String?
  price       Decimal       @db.Decimal(12, 2)
  inventoryQuantity Int     @default(0)
  imageUrls   String[]      @default([])
  currency    String        @default("NGN")
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  orderItems  OrderItem[]
  variants    ProductVariant[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, categoryId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  name       String
  sku        String?
  price      Decimal? @db.Decimal(12, 2)
  inventoryQuantity Int @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  name      String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Order {
  id                   String      @id @default(cuid())
  tenantId             String
  customerId           String?
  customerName         String?
  customerEmail        String?
  customerPhone        String?
  shippingAddress      String?
  shippingCity         String?
  shippingState        String?
  paymentReference     String?     @unique
  status               OrderStatus @default(PENDING)
  total                Decimal     @db.Decimal(12, 2)
  currency             String      @default("NGN")
  paidAt               DateTime?
  expiresAt            DateTime?
  inventoryReleasedAt  DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  tenant               Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer             Customer?   @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items                OrderItem[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, customerId])
}

model OrderItem {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  productId   String
  productName String?
  variantId   String?
  variantName String?
  sku         String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  product     Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, orderId])
  @@index([tenantId, productId])
  @@index([tenantId, variantId])
}
